{
    "openapi": "3.0.3",
    "info": {
        "title": "ETH Staker Deposit Backend API",
        "description": "API for requesting Ethereum validator/builder information by withdrawal credential execution address.",
        "version": "0.1.0",
        "license": {
            "name": "AGPL-3.0",
            "url": "https://www.gnu.org/licenses/agpl-3.0.en.html"
        }
    },
    "paths": {
        "/api/v1/address/{execution_address}": {
            "get": {
                "operationId": "getByExecutionAddress",
                "summary": "Get information by execution address",
                "description": "Retrieve builder and validator information by execution address",
                "parameters": [
                    {
                        "name": "execution_address",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "$ref": "#/components/schemas/ExecutionAddress"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successfully retrieved builder and validator information",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "builders": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/BuilderInfo"
                                            }
                                        },
                                        "validators": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/ValidatorInfo"
                                            }
                                        }
                                    },
                                    "anyOf": [
                                        {
                                            "required": [
                                                "builders"
                                            ]
                                        },
                                        {
                                            "required": [
                                                "validators"
                                            ]
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid execution address format"
                    },
                    "404": {
                        "description": "No builders or validators found for the given execution address"
                    },
                    "500": {
                        "description": "Internal server error"
                    }
                }
            }
        },
        "/api/v1/builders/{execution_address}": {
            "get": {
                "operationId": "getBuildersByExecutionAddress",
                "summary": "Get builders by execution address",
                "description": "Retrieve all builders associated with a specific execution address as its 0xb0 credential",
                "parameters": [
                    {
                        "name": "execution_address",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "$ref": "#/components/schemas/ExecutionAddress"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successfully retrieved builders",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/BuilderInfo"
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid execution address format"
                    },
                    "404": {
                        "description": "No builders found for the given execution address"
                    },
                    "500": {
                        "description": "Internal server error"
                    }
                }
            }
        },
        "/api/v1/validators/{execution_address}": {
            "get": {
                "operationId": "getValidatorsByExecutionAddress",
                "summary": "Get validators by execution address",
                "description": "Retrieve all validators associated with a specific execution address as its 0x01 or 0x02 credential",
                "parameters": [
                    {
                        "name": "execution_address",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "$ref": "#/components/schemas/ExecutionAddress"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successfully retrieved validators",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/ValidatorInfo"
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid execution address format"
                    },
                    "404": {
                        "description": "No validators found for the given execution address"
                    },
                    "500": {
                        "description": "Internal server error"
                    }
                }
            }
        },
        "/api/v1/validator/{public_key}": {
            "get": {
                "operationId": "getValidatorByPublicKey",
                "summary": "Get validator by public key",
                "description": "Retrieve a validator by its public key",
                "parameters": [
                    {
                        "name": "public_key",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "$ref": "#/components/schemas/PublicKey"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successfully retrieved validator",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "https://raw.githubusercontent.com/ethereum/beacon-APIs/master/types/api.yaml#/ValidatorResponse"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid public key format"
                    },
                    "404": {
                        "description": "No validator found for the given public key"
                    },
                    "500": {
                        "description": "Internal server error"
                    }
                }
            }
        },
        "/api/v1/builder/{public_key}": {
            "get": {
                "operationId": "getBuilderByPublicKey",
                "summary": "Get builder by public key",
                "description": "Retrieve a builder by its public key",
                "parameters": [
                    {
                        "name": "public_key",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "$ref": "#/components/schemas/PublicKey"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successfully retrieved builder",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "https://raw.githubusercontent.com/ethereum/beacon-APIs/master/types/api.yaml#/BuilderResponse"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid public key format"
                    },
                    "404": {
                        "description": "No builder found for the given public key"
                    },
                    "500": {
                        "description": "Internal server error"
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "ExecutionAddress": {
                "type": "string",
                "pattern": "^0x[a-fA-F0-9]{40}$",
                "example": "0x0011223344556677889900112233445566778899",
                "description": "The execution address to search for builders and validators"
            },
            "PublicKey": {
                "type": "string",
                "pattern": "^0x[a-fA-F0-9]{96}$",
                "example": "0x001122334455667788990011223344556677889900112233445566778899001122334455667788990011223344556677",
                "description": "The public key of the builder or validator"
            },
            "BuilderInfo": {
                "type": "object",
                "required": [
                    "builder"
                ],
                "properties": {
                    "builder": {
                        "$ref": "https://raw.githubusercontent.com/ethereum/beacon-APIs/master/types/api.yaml#/BuilderResponse"
                    },
                    "pending_payments": {
                        "type": "array",
                        "description": "Pending payments from the builder",
                        "items": {
                            "$ref": "https://raw.githubusercontent.com/ethereum/beacon-APIs/master/types/gloas/builder.yaml#/Gloas/BuilderPendingPayment"
                        }
                    },
                    "pending_withdrawals": {
                        "$ref": "https://raw.githubusercontent.com/ethereum/beacon-APIs/master/types/gloas/builder.yaml#/Gloas/BuilderPendingWithdrawals"
                    }
                }
            },
            "ValidatorInfo": {
                "type": "object",
                "required": [
                    "validator"
                ],
                "properties": {
                    "validator": {
                        "$ref": "https://raw.githubusercontent.com/ethereum/beacon-APIs/master/types/api.yaml#/ValidatorResponse"
                    },
                    "pending_consolidations": {
                        "type": "array",
                        "description": "Pending consolidations from or to the validator",
                        "items": {
                            "$ref": "https://raw.githubusercontent.com/ethereum/beacon-APIs/master/types/electra/consolidation.yaml#/Electra/PendingConsolidation"
                        }
                    },
                    "pending_deposits": {
                        "type": "array",
                        "description": "Pending deposits to the validator",
                        "items": {
                            "$ref": "https://raw.githubusercontent.com/ethereum/beacon-APIs/master/types/electra/deposit.yaml#/Electra/PendingDeposit"
                        }
                    },
                    "pending_partial_withdrawals": {
                        "type": "array",
                        "description": "Pending partial withdrawals from the validator",
                        "items": {
                            "$ref": "https://raw.githubusercontent.com/ethereum/beacon-APIs/master/types/electra/withdrawal.yaml#/Electra/PendingPartialWithdrawal"
                        }
                    }
                }
            }
        }
    }
}
